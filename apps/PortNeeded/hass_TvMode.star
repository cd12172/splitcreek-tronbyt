# Exmaple of how to use Stack with Rows and Columns to control quadrant position of text on the tidbyt.
# by tavdog

load("encoding/base64.star", "base64")
load("http.star", "http")
load("render.star", "render")

TV = base64.decode("""""")
def GetHASS():
  jsonHeader = http.get("http://192.168.1.160:8111/api/v1/variable/strMessage")
  if jsonHeader == None:
    jsonHeader = "{'name':'strMessage','expr':'HASS Error','index':32767,'value':'Hass Error','since':1705676967557}"
  if jsonHeader.json()["value"] == None:
    r = "Hass Error"
  else:
	r = jsonHeader.json()["value"].strip('"')
  
  l = int((64 - len(r))/2)
  print(l)
 
  #for x in range(l): 
  #  r = r+ ' '
  #print(r) 
  return r


def main():
  strAlert = GetHASS()

  return render.Root(
    child = render.Row(
      children = [
	    render.Column(
          children = [
		    render.Marquee(
              width=64,
              child=render.Text(strAlert),
                offset_start=5,
                offset_end=32,
		        scroll_direction = "horizontal"
            ),          
		    render.Image(
  		      src = TV,
		      width = 22,
		      height = 22,
		    ),
		  ],
        ),
	  ],
    ),
  )	
    
  